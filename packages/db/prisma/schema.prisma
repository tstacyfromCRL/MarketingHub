generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Users, auth, preferences
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  CREATOR
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              Role      @default(CREATOR)
  active            Boolean   @default(true)
  slackUserId       String?
  /// { inApp, email, slack }
  notificationPrefs Json      @default("{\"inApp\":true,\"email\":true,\"slack\":false}")
  libraryConfigured Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  quickLinks       QuickLink[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  notifications    Notification[]
  activity         ActivityEvent[]
  scheduleEvents   ScheduleEvent[]
  createdPosts     Post[]           @relation("PostCreator")
  reviewedPosts    Post[]           @relation("PostReviewer")
  designs          Design[]
  campaigns        Campaign[]
  contentDocs      ContentDoc[]
  socialAccounts   SocialAccount[]
}

/// One-time sign-up code an admin hands to a new team member; the code decides their role.
model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  role        Role      @default(CREATOR)
  email       String?
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())
}

model QuickLink {
  id        String   @id @default(cuid())
  /// null = company-wide link shown to everyone
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Shared asset library (mapped Windows drive, indexed by desktop clients)
// ---------------------------------------------------------------------------

model Library {
  id          String      @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime    @default(now())
  assets      Asset[]
  lease       ScanLease?
}

/// Only one desktop client may scan the library at a time.
model ScanLease {
  libraryId  String   @id
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  token      String   @unique
  holderId   String
  machine    String
  expiresAt  DateTime
  startedAt  DateTime @default(now())
  lastScanAt DateTime?
}

enum AssetKind {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model Asset {
  id           String                 @id @default(cuid())
  libraryId    String
  library      Library                @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// Path relative to the library root, forward slashes.
  relPath      String
  size         BigInt
  mtime        DateTime
  kind         AssetKind
  thumbnailKey String?
  /// Set when a user has uploaded the full file for use in generated content.
  storedKey    String?
  description  String                 @default("")
  tags         String[]
  embedding    Unsupported("vector")?
  missing      Boolean                @default(false)
  needsTagging Boolean                @default(true)
  indexedAt    DateTime               @default(now())
  products     AssetProduct[]

  @@unique([libraryId, relPath])
  @@index([kind])
}

model AssetProduct {
  assetId    String
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  similarity Float   @default(0)
  /// null = suggested by the matcher, true = confirmed by a user, false = rejected by a user
  confirmed  Boolean?

  @@id([assetId, productId])
}

// ---------------------------------------------------------------------------
// Tasks / kanban
// ---------------------------------------------------------------------------

model Board {
  id     String  @id @default(cuid())
  name   String
  stages Stage[]
  tasks  Task[]
}

model Stage {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String @default("#64748b")
  order   Int
  tasks   Task[]
}

model TaskCategory {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6366f1")
  tasks Task[]
}

model Task {
  id          String         @id @default(cuid())
  boardId     String
  board       Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  stageId     String
  stage       Stage          @relation(fields: [stageId], references: [id], onDelete: Restrict)
  title       String
  description String         @default("")
  order       Float          @default(0)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     User           @relation("TaskCreator", fields: [creatorId], references: [id])
  categories  TaskCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([stageId, order])
}

// ---------------------------------------------------------------------------
// Work log, notifications, team calendar
// ---------------------------------------------------------------------------

model ActivityEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  verb       String
  entityType String
  entityId   String
  summary    String
  /// In-app deep link, e.g. /posts/abc
  link       String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @default("")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model ScheduleEvent {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  startsAt DateTime
  endsAt   DateTime
  allDay   Boolean  @default(false)
  notes    String   @default("")

  @@index([startsAt])
}

// ---------------------------------------------------------------------------
// Knowledge base
// ---------------------------------------------------------------------------

/// Singleton row (id = "brand").
model BrandProfile {
  id             String   @id @default("brand")
  companyName    String   @default("")
  /// What the company does; approved during setup and refined as knowledge grows.
  summary        String   @default("")
  website        String   @default("")
  tagline        String   @default("")
  mission        String   @default("")
  voice          String   @default("")
  visualIdentity String   @default("")
  audience       String   @default("")
  colors         Json     @default("[]")
  fonts          Json     @default("[]")
  dos            String[]
  donts          String[]
  updatedAt      DateTime @updatedAt
}

enum BrandFileKind {
  LOGO
  GRAPHIC
  FONT
  GENERATED
  EXPORT
}

/// Files uploaded to object storage (logos, generated images, exports).
model BrandFile {
  id         String        @id @default(cuid())
  kind       BrandFileKind
  name       String
  storageKey String        @unique
  mime       String
  size       Int
  createdAt  DateTime      @default(now())
}

model Product {
  id          String         @id @default(cuid())
  name        String
  sku         String         @default("")
  description String         @default("")
  features    String[]
  url         String         @default("")
  pricing     String         @default("")
  /// Extra pages about the product; each is scraped into a Source linked to this product.
  links       String[]
  active      Boolean        @default(true)
  /// Mean image embedding of confirmed assets, used for product matching.
  centroid    Unsupported("vector")?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assets      AssetProduct[]
}

model Accomplishment {
  id          String    @id @default(cuid())
  title       String
  date        DateTime?
  description String    @default("")
  createdAt   DateTime  @default(now())
}

enum SourceKind {
  WEBSITE
  ARTICLE
  LINKEDIN
  MANUAL
  /// A past social post pasted in as an example of the brand voice.
  SAMPLE_POST
}

enum SourceStatus {
  PENDING
  OK
  ERROR
}

model Source {
  id            String       @id @default(cuid())
  url           String?
  kind          SourceKind
  /// Set for pages scraped from a product's links.
  productId     String?
  /// Platform a SAMPLE_POST was published on, if known.
  platform      String?
  title         String       @default("")
  content       String       @default("")
  status        SourceStatus @default(PENDING)
  error         String?
  recrawlDays   Int?
  lastCrawledAt DateTime?
  createdAt     DateTime     @default(now())

  @@index([productId])
}

/// Embedded text chunks used for retrieval-augmented generation.
model KnowledgeChunk {
  id         String                 @id @default(cuid())
  /// BRAND | PRODUCT | ACCOMPLISHMENT | SOURCE
  sourceType String
  sourceId   String
  text       String
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())

  @@index([sourceType, sourceId])
}

// ---------------------------------------------------------------------------
// Content, designs, posts, campaigns, publishing
// ---------------------------------------------------------------------------

enum ContentType {
  SOCIAL_POST
  EMAIL
  BLOG
  DOCUMENTATION
}

model ContentDoc {
  id          String      @id @default(cuid())
  type        ContentType
  title       String
  body        String
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Design {
  id          String        @id @default(cuid())
  name        String
  /// DesignDoc JSON (see @mh/shared design.ts)
  doc         Json
  previewKey  String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  posts       Post[]
  variants    PostVariant[]
}

enum CampaignStatus {
  GENERATING
  READY
  FAILED
}

model Campaign {
  id               String         @id @default(cuid())
  name             String
  brief            String
  startDate        DateTime
  endDate          DateTime
  postDays         Int[]
  postTimes        String[]
  utcOffsetMinutes Int
  platforms        String[]
  perPlatformFiles Boolean        @default(true)
  productIds       String[]
  generateGraphics Boolean        @default(true)
  status           CampaignStatus @default(GENERATING)
  error            String?
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  posts            Post[]
}

enum PostStatus {
  DRAFT
  CREATOR_APPROVED
  IN_REVIEW
  SCHEDULED
  POSTED
  FAILED
}

model Post {
  id               String        @id @default(cuid())
  campaignId       String?
  campaign         Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title            String
  body             String
  platforms        String[]
  perPlatformFiles Boolean       @default(true)
  status           PostStatus    @default(DRAFT)
  scheduledAt      DateTime?
  postedAt         DateTime?
  reviewNote       String?
  designId         String?
  design           Design?       @relation(fields: [designId], references: [id], onDelete: SetNull)
  creatorId        String
  creator          User          @relation("PostCreator", fields: [creatorId], references: [id])
  reviewerId       String?
  reviewer         User?         @relation("PostReviewer", fields: [reviewerId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  variants         PostVariant[]

  @@index([status, scheduledAt])
}

enum VariantStatus {
  PENDING
  POSTED
  FAILED
}

/// One per target platform; holds platform-specific copy/graphics and the publish result.
model PostVariant {
  id          String        @id @default(cuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform    String
  body        String
  designId    String?
  design      Design?       @relation(fields: [designId], references: [id], onDelete: SetNull)
  status      VariantStatus @default(PENDING)
  externalId  String?
  externalUrl String?
  error       String?
  attempts    Int           @default(0)
  postedAt    DateTime?

  @@unique([postId, platform])
}

model SocialAccount {
  id             String    @id @default(cuid())
  platform       String
  displayName    String
  externalId     String
  /// AES-256-GCM encrypted
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt      DateTime?
  meta           Json      @default("{}")
  connectedById  String
  connectedBy    User      @relation(fields: [connectedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([platform, externalId])
}

/// Server-side OAuth state for social connection flows started from the desktop app.
model OAuthState {
  state     String   @id
  platform  String
  userId    String
  verifier  String?
  createdAt DateTime @default(now())
}
