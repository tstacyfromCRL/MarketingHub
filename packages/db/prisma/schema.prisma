generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// TENANCY: User, Invite, QuickLink, AppSetting, Library, LibraryImport, ScanLease, Asset,
// AssetProduct, Board, Stage, TaskCategory, Task, ActivityEvent, Notification, ScheduleEvent,
// BrandFile, ContentDoc, Design, Campaign, Post, PostVariant, SocialAccount and OAuthState
// are still global. Add organizationId to each before a second company uses this database.

// ---------------------------------------------------------------------------
// Users, auth, preferences
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  CREATOR
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              Role      @default(CREATOR)
  active            Boolean   @default(true)
  slackUserId       String?
  /// { inApp, email, slack }
  notificationPrefs Json      @default("{\"inApp\":true,\"email\":true,\"slack\":false}")
  libraryConfigured Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  quickLinks       QuickLink[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  notifications    Notification[]
  activity         ActivityEvent[]
  scheduleEvents   ScheduleEvent[]
  createdPosts     Post[]           @relation("PostCreator")
  reviewedPosts    Post[]           @relation("PostReviewer")
  designs          Design[]
  campaigns        Campaign[]
  contentDocs      ContentDoc[]
  socialAccounts   SocialAccount[]
  canvaAccounts    CanvaAccount[]
  assistantThreads AssistantThread[]
}

/// A conversation with the Mantis assistant. Each person sees only their own.
model AssistantThread {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
}

/// One line in an assistant conversation. Tool calls are not stored; what they made is in actions.
model AssistantMessage {
  id        String          @id @default(cuid())
  threadId  String
  thread    AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// user or assistant
  role      String
  content   String
  /// Links to what the assistant created or changed: [{ kind, label, link }]
  actions   Json            @default("[]")
  /// Without an AI key, the earlier sentence when the reply asked for a missing detail.
  context   String?
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
}

/// One-time sign-up code an admin hands to a new team member; the code decides their role.
model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  role        Role      @default(CREATOR)
  email       String?
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())
}

model QuickLink {
  id        String   @id @default(cuid())
  /// null = company-wide link shown to everyone
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Shared asset library (mapped Windows drive, indexed by desktop clients)
// ---------------------------------------------------------------------------

model Library {
  id          String      @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime    @default(now())
  assets      Asset[]
  lease       ScanLease?
  imports     LibraryImport[]
  holds       LibraryHold[]
}

enum LibraryImportKind {
  FOLDER
  FILE
}

/// A file or folder inside the library drive that the team has chosen to index. Everything else on the drive is ignored.
model LibraryImport {
  id        String            @id @default(cuid())
  libraryId String
  library   Library           @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// Path relative to the library root, forward slashes. Empty means the drive root itself.
  relPath   String
  kind      LibraryImportKind
  addedById String
  createdAt DateTime          @default(now())

  @@unique([libraryId, relPath])
}

/// A file or folder the team can browse but AI must not read or place in generated work.
model LibraryHold {
  id        String            @id @default(cuid())
  libraryId String
  library   Library           @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  relPath   String
  kind      LibraryImportKind
  createdAt DateTime          @default(now())

  @@unique([libraryId, relPath])
}

/// Only one desktop client may scan the library at a time.
model ScanLease {
  libraryId  String   @id
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  token      String   @unique
  holderId   String
  machine    String
  expiresAt  DateTime
  startedAt  DateTime @default(now())
  lastScanAt DateTime?
}

enum AssetKind {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model Asset {
  id           String                 @id @default(cuid())
  libraryId    String
  library      Library                @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// Path relative to the library root, forward slashes.
  relPath      String
  size         BigInt
  mtime        DateTime
  kind         AssetKind
  thumbnailKey String?
  /// Set when a user has uploaded the full file for use in generated content.
  storedKey    String?
  description  String                 @default("")
  tags         String[]
  embedding    Unsupported("vector")?
  missing      Boolean                @default(false)
  /// Removed from the library on purpose. Scans leave the file on the drive and do not index it again.
  excluded     Boolean                @default(false)
  /// Still shown in the library. Vision, embeddings, product matching, and generated graphics skip it.
  notForPublicUse Boolean             @default(false)
  needsTagging Boolean                @default(true)
  indexedAt    DateTime               @default(now())
  products     AssetProduct[]

  @@unique([libraryId, relPath])
  @@index([kind])
}

model AssetProduct {
  assetId    String
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  similarity Float   @default(0)
  /// null = suggested by the matcher, true = confirmed by a user, false = rejected by a user
  confirmed  Boolean?

  @@id([assetId, productId])
}

// ---------------------------------------------------------------------------
// Tasks / kanban
// ---------------------------------------------------------------------------

model Board {
  id     String  @id @default(cuid())
  name   String
  stages Stage[]
  tasks  Task[]
}

model Stage {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String @default("#64748b")
  order   Int
  tasks   Task[]
}

model TaskCategory {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6366f1")
  tasks Task[]
}

model Task {
  id          String         @id @default(cuid())
  boardId     String
  board       Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  stageId     String
  stage       Stage          @relation(fields: [stageId], references: [id], onDelete: Restrict)
  title       String
  description String         @default("")
  order       Float          @default(0)
  dueDate     DateTime?
  /// Archived tasks stay in the database and drop off the board.
  active      Boolean        @default(true)
  assigneeId  String?
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     User           @relation("TaskCreator", fields: [creatorId], references: [id])
  categories  TaskCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([stageId, order])
}

// ---------------------------------------------------------------------------
// Work log, notifications, team calendar
// ---------------------------------------------------------------------------

model ActivityEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  verb       String
  entityType String
  entityId   String
  summary    String
  /// In-app deep link, e.g. /posts/abc
  link       String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @default("")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model ScheduleEvent {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  startsAt DateTime
  endsAt   DateTime
  allDay   Boolean  @default(false)
  notes    String   @default("")

  @@index([startsAt])
}

// ---------------------------------------------------------------------------
// Knowledge base
// ---------------------------------------------------------------------------

/// One company today. A second row exists only in tests; there is no org switcher.
model Organization {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now())
  brandProfile      BrandProfile?
  products          Product[]
  accomplishments   Accomplishment[]
  sources           Source[]
  chunks            KnowledgeChunk[]
  promptTemplates   PromptTemplate[]
  claims            Claim[]
  confidentialTerms ConfidentialTerm[]
  integrations      IntegrationSetting[]
  marketLinks       MarketLink[]
}

enum Sensitivity {
  PUBLIC
  INTERNAL
  RESTRICTED
}

/// The brand profile for one organization. Look up by organizationId, not a fixed id.
model BrandProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName    String       @default("")
  /// What the company does; approved during setup and refined as knowledge grows.
  summary        String       @default("")
  website        String       @default("")
  tagline        String       @default("")
  mission        String       @default("")
  voice          String       @default("")
  visualIdentity String       @default("")
  audience       String       @default("")
  colors         Json         @default("[]")
  fonts          Json         @default("[]")
  dos            String[]
  donts          String[]
  updatedAt      DateTime     @updatedAt
}

enum BrandFileKind {
  LOGO
  GRAPHIC
  FONT
  GENERATED
  EXPORT
  /// A past social graphic. Sent with new images so they can follow its look.
  STYLE
  /// A full-frame plate chosen in the graphics editor.
  BACKGROUND
}

// TENANCY: BrandFile is not org-scoped yet. New knowledge files use orgs/<orgId>/ keys.
/// Files uploaded to object storage (logos, generated images, exports).
model BrandFile {
  id         String        @id @default(cuid())
  kind       BrandFileKind
  name       String
  storageKey String        @unique
  mime       String
  size       Int
  createdAt  DateTime      @default(now())
}

model Product {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Primary part number. Also the first entry of partNumbers when someone edits the list.
  sku            String         @default("")
  /// What the product does.
  description    String         @default("")
  /// How the product is used. Kept apart from description so the writer can tell the two apart.
  usage          String         @default("")
  /// Pack-owned positioning. A connector sync must not overwrite this.
  positioning    String         @default("")
  features       String[]
  /// Every part number, including the primary sku. A connector refresh does not clear this list.
  partNumbers    String[]       @default([])
  /// Copy of pack-owned features so a connector refresh can restore them.
  packFeatures   String[]       @default([])
  url            String         @default("")
  pricing        String         @default("")
  /// Extra pages about the product; each is scraped into a Source linked to this product.
  links          String[]
  packLinks      String[]       @default([])
  active         Boolean        @default(true)
  sensitivity    Sensitivity    @default(PUBLIC)
  externalKey    String?
  /// Set when a connector owns or is merged onto this row.
  connectorKey   String?
  origin         String         @default("manual")
  contentHash    String?
  lastSyncedAt   DateTime?
  /// Mean image embedding of confirmed assets, used for product matching.
  centroid       Unsupported("vector")?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assets         AssetProduct[]
  marketLinks    MarketLink[]
  designTags     DesignProduct[]

  @@unique([organizationId, externalKey])
  @@unique([organizationId, connectorKey])
  @@index([organizationId, sku])
}

enum MarketRole {
  COMPETITOR
  PARTNER
}

/// A competitor or partner website or social page. Its text is labeled as market context, not as our claim.
model MarketLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  role           MarketRole
  url            String
  channel        String       @default("website")
  /// Source row that holds the scraped page, or the short social-link note when the host cannot be fetched.
  sourceId       String?      @unique
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productId])
}

model Accomplishment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  date           DateTime?
  description    String       @default("")
  sensitivity    Sensitivity  @default(PUBLIC)
  externalKey    String?
  origin         String       @default("manual")
  contentHash    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, externalKey])
}

enum SourceKind {
  WEBSITE
  ARTICLE
  LINKEDIN
  MANUAL
  /// A past social post pasted in as an example of the brand voice.
  SAMPLE_POST
  /// An uploaded or pack-supplied reference document.
  DOCUMENT
}

enum SourceStatus {
  PENDING
  OK
  ERROR
}

model Source {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String?
  kind           SourceKind
  /// Set when this page belongs to a product: a documentation link, an upload, or a competitor/partner page.
  productId      String?
  /// Platform a SAMPLE_POST was published on, if known.
  platform       String?
  title          String       @default("")
  content        String       @default("")
  status         SourceStatus @default(PENDING)
  error          String?
  sensitivity    Sensitivity  @default(PUBLIC)
  externalKey    String?
  /// manual, pack, upload, product-link, or market. A documentation-link refresh only replaces product-link pages.
  origin         String       @default("manual")
  contentHash    String?
  recrawlDays    Int?
  lastCrawledAt  DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, externalKey])
  @@index([productId])
  @@index([organizationId, kind])
}

/// Embedded text chunks used for retrieval-augmented generation.
model KnowledgeChunk {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// BRAND | PRODUCT | ACCOMPLISHMENT | SOURCE | CLAIM
  sourceType     String
  sourceId       String
  text           String
  sensitivity    Sensitivity            @default(PUBLIC)
  embedding      Unsupported("vector")?
  createdAt      DateTime               @default(now())

  @@index([sourceType, sourceId])
  @@index([organizationId, sourceType])
}

/// Writing instructions selected by platform, content type and pillar. Not retrieved by search.
model PromptTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalKey    String?
  name           String
  platform       String?
  contentType    String?
  pillar         String?
  /// The instructions themselves.
  body           String
  hashtagMin     Int?
  hashtagMax     Int?
  maxChars       Int?
  version        Int          @default(1)
  active         Boolean      @default(true)
  origin         String       @default("manual")
  contentHash    String?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, externalKey])
  @@index([organizationId, active])
}

/// Approved public statements and statistics. The only numbers the model may quote.
model Claim {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalKey    String?
  text           String
  sourceUrl      String       @default("")
  asOf           DateTime?
  expiresAt      DateTime?
  /// APPROVED | RETIRED
  status         String       @default("APPROVED")
  productIds     String[]
  sensitivity    Sensitivity  @default(PUBLIC)
  origin         String       @default("manual")
  contentHash    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, externalKey])
  @@index([organizationId, status])
}

/// Names the model must never write: customers, partners and programs under NDA.
model ConfidentialTerm {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  term           String
  aliases        String[]
  note           String       @default("")
  origin         String       @default("manual")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, term])
}

/// Per-org connector config. The secret payload is encrypted with ENCRYPTION_KEY.
model IntegrationSetting {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorId     String
  enabled         Boolean      @default(false)
  configEncrypted String
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, connectorId])
}

// ---------------------------------------------------------------------------
// Content, designs, posts, campaigns, publishing
// ---------------------------------------------------------------------------

enum ContentType {
  SOCIAL_POST
  EMAIL
  BLOG
  DOCUMENTATION
}

model ContentDoc {
  id          String      @id @default(cuid())
  type        ContentType
  title       String
  body        String
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// A folder in the content studio. Deleting the folder unfiles its graphics; it does not delete them.
model DesignFolder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  designs   Design[]
}

/// A product tag on a graphic. The graphic can carry more than one product.
model DesignProduct {
  designId  String
  productId String
  design    Design  @relation(fields: [designId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([designId, productId])
  @@index([productId])
}

model Design {
  id          String          @id @default(cuid())
  name        String
  /// DesignDoc JSON (see @mh/shared design.ts)
  doc         Json
  previewKey    String?
  /// Canva design this graphic edits. The picture stored here is the last export from that design.
  canvaDesignId String?         @unique
  folderId      String?
  folder      DesignFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  posts       Post[]
  variants    PostVariant[]
  products    DesignProduct[]

  @@index([folderId])
}

enum CampaignStatus {
  GENERATING
  READY
  FAILED
}

// TENANCY: Campaign is not org-scoped yet.
model Campaign {
  id               String         @id @default(cuid())
  name             String
  brief            String
  /// Content pillar this campaign is written for. Playbooks are data, not an enum.
  pillar           String?
  startDate        DateTime
  endDate          DateTime
  postDays         Int[]
  postTimes        String[]
  utcOffsetMinutes Int
  platforms        String[]
  perPlatformFiles Boolean        @default(true)
  productIds       String[]
  generateGraphics Boolean        @default(true)
  status           CampaignStatus @default(GENERATING)
  error            String?
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  posts            Post[]
}

enum PostStatus {
  DRAFT
  CREATOR_APPROVED
  IN_REVIEW
  SCHEDULED
  POSTED
  FAILED
}

// TENANCY: Post is not org-scoped yet.
model Post {
  id               String        @id @default(cuid())
  campaignId       String?
  pillar           String?
  /// Validator warnings from the last AI draft. Shown, never used to block.
  aiWarnings       Json          @default("[]")
  campaign         Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title            String
  body             String
  platforms        String[]
  perPlatformFiles Boolean       @default(true)
  status           PostStatus    @default(DRAFT)
  scheduledAt      DateTime?
  postedAt         DateTime?
  reviewNote       String?
  designId         String?
  design           Design?       @relation(fields: [designId], references: [id], onDelete: SetNull)
  creatorId        String
  creator          User          @relation("PostCreator", fields: [creatorId], references: [id])
  reviewerId       String?
  reviewer         User?         @relation("PostReviewer", fields: [reviewerId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  variants         PostVariant[]

  @@index([status, scheduledAt])
}

enum VariantStatus {
  PENDING
  POSTED
  FAILED
}

/// One per target platform; holds platform-specific copy/graphics and the publish result.
// TENANCY: PostVariant is not org-scoped yet.
model PostVariant {
  id          String        @id @default(cuid())
  postId      String
  aiWarnings  Json          @default("[]")
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform    String
  body        String
  designId    String?
  design      Design?       @relation(fields: [designId], references: [id], onDelete: SetNull)
  status      VariantStatus @default(PENDING)
  externalId  String?
  externalUrl String?
  error       String?
  attempts    Int           @default(0)
  postedAt    DateTime?

  @@unique([postId, platform])
}

/// One Canva login for the team. Tokens stay encrypted on the server.
model CanvaAccount {
  id              String   @id @default(cuid())
  canvaUserId     String   @unique
  teamId          String?
  displayName     String
  /// AES-256-GCM encrypted
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  connectedById   String
  connectedBy     User     @relation(fields: [connectedById], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SocialAccount {
  id             String    @id @default(cuid())
  platform       String
  displayName    String
  externalId     String
  /// AES-256-GCM encrypted
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt      DateTime?
  meta           Json      @default("{}")
  connectedById  String
  connectedBy    User      @relation(fields: [connectedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([platform, externalId])
}

/// Server-side OAuth state for social connection flows started from the desktop app.
model OAuthState {
  state     String   @id
  platform  String
  userId    String
  verifier  String?
  createdAt DateTime @default(now())
}
