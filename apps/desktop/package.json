{
  "name": "@mh/desktop",
  "productName": "Marketing Hub",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing Hub desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mh/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "konva": "^9.3.18",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.marketinghub.desktop",
    "productName": "Marketing Hub",
    "directories": { "output": "release" },
    "files": ["out/**/*"],
    "protocols": [{ "name": "Marketing Hub", "schemes": ["marketinghub"] }],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "publish": [{ "provider": "generic", "url": "https://updates.example.com/marketing-hub/" }]
  }
}
