{
  "name": "@mh/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --target node20 --out-dir dist --clean --noExternal @mh/shared --noExternal @mh/core --noExternal @mh/render --noExternal @mh/db",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/websocket": "^11.0.1",
    "@mh/core": "workspace:*",
    "@mh/db": "workspace:*",
    "@mh/render": "workspace:*",
    "@mh/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
