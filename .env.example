# ---- Core ----
PORT=4000
PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://mh:mh@localhost:5432/marketinghub
# Leave REDIS_URL empty to run background jobs in-process inside the server (dev only).
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---- Object storage ----
# s3 (AWS S3 / MinIO) or local (files under LOCAL_STORAGE_DIR)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketing-hub
S3_ACCESS_KEY=mh
S3_SECRET_KEY=mh-minio-secret
LOCAL_STORAGE_DIR=.data/storage

# ---- Notifications ----
# e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
EMAIL_FROM="Marketing Hub <noreply@example.com>"
SLACK_BOT_TOKEN=

# ---- AI providers (mock | openai | anthropic) ----
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
AI_EMBED_PROVIDER=mock
AI_VISION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_EMBED_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Social publishing ----
# direct (official platform APIs) or ayrshare (aggregator stopgap)
PUBLISH_MODE=direct
AYRSHARE_API_KEY=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
